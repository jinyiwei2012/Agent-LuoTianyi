{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentluo.local/contracts/minecraft/v1/schema.json",
  "title": "Minecraft semantic contract v1 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "type",
    "actorId",
    "worldId",
    "bodyId",
    "sessionId",
    "sessionEpoch",
    "messageId",
    "timestamp",
    "payload"
  ],
  "properties": {
    "protocol": {
      "const": "luosandbox.minecraft.v1"
    },
    "type": {
      "enum": [
        "observation",
        "request",
        "admission",
        "cancel",
        "cancel_result",
        "receipt",
        "reconcile",
        "reconcile_result"
      ]
    },
    "actorId": {
      "$ref": "#/$defs/id"
    },
    "worldId": {
      "$ref": "#/$defs/id"
    },
    "bodyId": {
      "$ref": "#/$defs/uuid"
    },
    "sessionId": {
      "$ref": "#/$defs/uuid"
    },
    "sessionEpoch": {
      "$ref": "#/$defs/i63"
    },
    "messageId": {
      "$ref": "#/$defs/uuid"
    },
    "timestamp": {
      "$ref": "#/$defs/utc"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "observation"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "admission"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/admission"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "cancel"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/cancel"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "cancel_result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/cancelResult"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "receipt"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/receipt"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "reconcile"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/reconcile"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "reconcile_result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/reconcileResult"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "i63": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "utc": {
      "type": "string",
      "pattern": "^(?!0000)\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "f64": {
      "type": "number"
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/f64",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "y": {
          "$ref": "#/$defs/f64",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "z": {
          "$ref": "#/$defs/f64",
          "minimum": -30000000,
          "maximum": 30000000
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensionId",
        "position",
        "yaw",
        "pitch"
      ],
      "properties": {
        "dimensionId": {
          "allOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "pattern": "^[a-z0-9_.-]+:[a-z0-9/._-]+$"
            }
          ]
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "yaw": {
          "$ref": "#/$defs/f64",
          "minimum": -180,
          "exclusiveMaximum": 180
        },
        "pitch": {
          "$ref": "#/$defs/f64",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "stamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverBootId",
        "serverRevision",
        "serverTick",
        "eventId",
        "evidence"
      ],
      "properties": {
        "serverBootId": {
          "$ref": "#/$defs/uuid"
        },
        "serverRevision": {
          "$ref": "#/$defs/i63"
        },
        "serverTick": {
          "$ref": "#/$defs/i63"
        },
        "eventId": {
          "$ref": "#/$defs/uuid"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "BINDING_MISMATCH",
        "STALE_EPOCH",
        "DEADLINE_EXPIRED",
        "ID_CONFLICT",
        "RATE_LIMIT",
        "BACKPRESSURE",
        "STALE_BASIS",
        "AUDIENCE_DENIED",
        "CAPABILITY_UNAVAILABLE",
        "REGION_DENIED",
        "UNSAFE_TARGET",
        "BODY_BUSY",
        "QUARANTINED",
        "TARGET_TERMINAL",
        "TARGET_NOT_FOUND",
        "OUTCOME_UNPROVEN",
        "HISTORY_UNAVAILABLE",
        "QUIESCENCE_UNPROVEN",
        "STUCK",
        "EXECUTION_REJECTED",
        "CANCEL_CONFIRMED",
        "CONTROL_LOST"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "QUERY",
        "PUBLIC_SAY",
        "LOOK",
        "BOUNDED_WALK",
        "STOP"
      ],
      "properties": {
        "QUERY": {
          "$ref": "#/$defs/cap"
        },
        "PUBLIC_SAY": {
          "$ref": "#/$defs/cap"
        },
        "LOOK": {
          "$ref": "#/$defs/cap"
        },
        "BOUNDED_WALK": {
          "$ref": "#/$defs/cap"
        },
        "STOP": {
          "$ref": "#/$defs/cap"
        }
      }
    },
    "cap": {
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE",
        "UNKNOWN"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stamp",
        "audience",
        "source",
        "freshness",
        "state",
        "capabilities",
        "untrustedText"
      ],
      "properties": {
        "stamp": {
          "$ref": "#/$defs/stamp"
        },
        "audience": {
          "const": "PUBLIC"
        },
        "source": {
          "const": "SERVER_AUTHORITATIVE"
        },
        "freshness": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ]
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "untrustedText": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "eventId",
              "text"
            ],
            "properties": {
              "eventId": {
                "$ref": "#/$defs/uuid"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "not": {
                  "pattern": "\\u0000"
                }
              }
            }
          }
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "serverBootId",
        "serverRevision"
      ],
      "properties": {
        "observationId": {
          "$ref": "#/$defs/uuid"
        },
        "serverBootId": {
          "$ref": "#/$defs/uuid"
        },
        "serverRevision": {
          "$ref": "#/$defs/i63"
        }
      }
    },
    "intent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "queryKind"
          ],
          "properties": {
            "kind": {
              "const": "QUERY"
            },
            "queryKind": {
              "const": "READ_ONLY_SUMMARY"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "message"
          ],
          "properties": {
            "kind": {
              "const": "PUBLIC_SAY"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?!.*[\\r\\n\\u0000])(?!\\s*/).*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "dimensionId",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "LOOK"
            },
            "dimensionId": {
              "$ref": "#/$defs/id"
            },
            "target": {
              "$ref": "#/$defs/position"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "dimensionId",
            "target",
            "maximumDistance"
          ],
          "properties": {
            "kind": {
              "const": "BOUNDED_WALK"
            },
            "dimensionId": {
              "$ref": "#/$defs/id"
            },
            "target": {
              "$ref": "#/$defs/position"
            },
            "maximumDistance": {
              "$ref": "#/$defs/f64",
              "exclusiveMinimum": 0,
              "maximum": 4
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deadline",
        "basis",
        "intent"
      ],
      "properties": {
        "deadline": {
          "$ref": "#/$defs/utc"
        },
        "basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/basis"
            },
            {
              "type": "null"
            }
          ]
        },
        "intent": {
          "$ref": "#/$defs/intent"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "intent": {
                "properties": {
                  "kind": {
                    "enum": [
                      "PUBLIC_SAY",
                      "LOOK",
                      "BOUNDED_WALK"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "basis": {
                "$ref": "#/$defs/basis"
              }
            }
          }
        }
      ]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "decision",
        "reason",
        "stamp"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "decision": {
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ]
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "stamp": {
          "$ref": "#/$defs/stamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "ACCEPTED"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "enum": [
                  "BINDING_MISMATCH",
                  "STALE_EPOCH",
                  "DEADLINE_EXPIRED",
                  "ID_CONFLICT",
                  "RATE_LIMIT",
                  "BACKPRESSURE",
                  "STALE_BASIS",
                  "AUDIENCE_DENIED",
                  "CAPABILITY_UNAVAILABLE",
                  "REGION_DENIED",
                  "UNSAFE_TARGET",
                  "BODY_BUSY",
                  "QUARANTINED"
                ]
              }
            }
          }
        }
      ]
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "targetRequestId",
        "targetEpoch",
        "deadline"
      ],
      "properties": {
        "mode": {
          "enum": [
            "TARGET",
            "EMERGENCY_REVOKE"
          ]
        },
        "targetRequestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetEpoch": {
          "$ref": "#/$defs/i63"
        },
        "deadline": {
          "$ref": "#/$defs/utc"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "TARGET"
              }
            }
          },
          "then": {
            "properties": {
              "targetRequestId": {
                "$ref": "#/$defs/uuid"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "EMERGENCY_REVOKE"
              }
            }
          },
          "then": {
            "properties": {
              "targetRequestId": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "cancelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancelId",
        "mode",
        "targetRequestId",
        "targetEpoch",
        "result",
        "reason",
        "stamp"
      ],
      "properties": {
        "cancelId": {
          "$ref": "#/$defs/uuid"
        },
        "mode": {
          "enum": [
            "TARGET",
            "EMERGENCY_REVOKE"
          ]
        },
        "targetRequestId": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetEpoch": {
          "$ref": "#/$defs/i63"
        },
        "result": {
          "enum": [
            "REQUESTED",
            "ALREADY_TERMINAL",
            "NOT_FOUND",
            "REVOKED",
            "REJECTED",
            "UNKNOWN"
          ]
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "stamp": {
          "$ref": "#/$defs/stamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "TARGET"
              }
            }
          },
          "then": {
            "properties": {
              "targetRequestId": {
                "$ref": "#/$defs/uuid"
              },
              "result": {
                "enum": [
                  "REQUESTED",
                  "ALREADY_TERMINAL",
                  "NOT_FOUND",
                  "REJECTED",
                  "UNKNOWN"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "EMERGENCY_REVOKE"
              }
            }
          },
          "then": {
            "properties": {
              "targetRequestId": {
                "const": null
              },
              "result": {
                "enum": [
                  "REVOKED",
                  "REJECTED",
                  "UNKNOWN"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "REQUESTED",
                  "REVOKED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "ALREADY_TERMINAL"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "TARGET_TERMINAL"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "NOT_FOUND"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "TARGET_NOT_FOUND"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "REJECTED"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "BINDING_MISMATCH",
                  "STALE_EPOCH",
                  "DEADLINE_EXPIRED",
                  "ID_CONFLICT",
                  "RATE_LIMIT",
                  "BACKPRESSURE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "OUTCOME_UNPROVEN",
                  "HISTORY_UNAVAILABLE"
                ]
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "effect",
        "state",
        "observationId"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SUMMARY",
            "PUBLIC_BROADCAST",
            "ORIENTATION",
            "POSITION",
            "STOPPED",
            "UNDETERMINED"
          ]
        },
        "effect": {
          "enum": [
            "NONE",
            "PARTIAL",
            "COMPLETE",
            "UNKNOWN"
          ]
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/state"
            },
            {
              "type": "null"
            }
          ]
        },
        "observationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "enum": [
                    "PUBLIC_BROADCAST",
                    "UNDETERMINED"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "$ref": "#/$defs/state"
              },
              "observationId": {
                "$ref": "#/$defs/uuid"
              }
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "status",
        "reason",
        "stamp",
        "outcome"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "TIMED_OUT",
            "CANCELLED",
            "DISCONNECTED",
            "UNKNOWN"
          ]
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "stamp": {
          "$ref": "#/$defs/stamp"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SUCCEEDED"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": null
              },
              "outcome": {
                "properties": {
                  "kind": {
                    "enum": [
                      "SUMMARY",
                      "PUBLIC_BROADCAST",
                      "ORIENTATION",
                      "POSITION"
                    ]
                  },
                  "effect": {
                    "const": "COMPLETE"
                  }
                },
                "required": [
                  "kind",
                  "effect"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "OUTCOME_UNPROVEN",
                  "HISTORY_UNAVAILABLE"
                ]
              },
              "outcome": {
                "properties": {
                  "kind": {
                    "const": "UNDETERMINED"
                  },
                  "effect": {
                    "const": "UNKNOWN"
                  }
                },
                "required": [
                  "kind",
                  "effect"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "UNSAFE_TARGET",
                  "STUCK",
                  "EXECUTION_REJECTED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "TIMED_OUT"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
